# The shop and practice desks use the same server-side AI settings.
VISION_PROVIDER=openai
VISION_MODEL=gpt-6.1-terra
# Optional overrides for complex blueprint comparison and the quote plan check.
# BLUEPRINT_AUDIT_MODEL=gpt-6.2-astra
# QUOTE_PLAN_REVIEW_MODEL=gpt-6.2-astra
# Optional overrides for the sketch assembly reader and the on-demand visual preview.
# SKETCH_ASSEMBLY_MODEL=gpt-6.2-astra
# SKETCH_VISUAL_MODEL=gpt-image-2.6-sunburst
# Supply OPENAI_API_KEY in .env.local or the server environment.
# To use the installed local reader, set VISION_PROVIDER=llama.cpp,
# VISION_MODEL=Qwen3-VL-2B-Instruct and VISION_BASE_URL=http://127.0.0.1:8187/v1.
# VISION_API_KEY is optional for a private compatible endpoint.
# LMM_DATA_DIR defaults to data/ under the project directory.

# Server-only PostgreSQL connections for Supabase quote history. TLS verifies the
# project certificate using supabase/prod-ca.crt. Use separate database logins
# inheriting lmm_history_ingest and lmm_history_read from the migrations.
# LMM_SUPABASE_WRITE_URL=postgresql://WRITER:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# LMM_SUPABASE_READ_URL=postgresql://READER:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# When moving the workstation database, set LMM_SUPABASE_DATA_DIR to its new folder.

# Gmail Web OAuth client. Set these server-only values in .env.local.
# LMM_GMAIL_CLIENT_ID=
# LMM_GMAIL_CLIENT_SECRET=
# LMM_GMAIL_REDIRECT_URI=http://127.0.0.1:3100/api/inbox/gmail/callback
