{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "NFIP_INTERNAL_API_URL"
        }
      ],
      "devCommand": "node ../../scripts/web.mjs dev --hostname 127.0.0.1"
    },
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "apps/api/Dockerfile"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
